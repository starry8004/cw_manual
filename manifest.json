{
  "manifest_version": 3,
  "name": "쿠팡 윙 상품등록 도우미",
  "version": "1.0.0",
  "description": "Alt+알파벳 단축키로 CSV 데이터를 쿠팡 윙에 빠르게 등록",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "쿠팡 상품등록 도우미 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
